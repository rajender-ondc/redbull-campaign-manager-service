erDiagram
    categories ||--o{ campaigns : "is promoted by"
    buyer_apps }o--o{ campaigns : "appears in buyer_apps array"
    affiliates }o--o{ campaigns : "appears in affiliates array"
    channels }o--o{ campaigns : "appears in affiliates.channelIds"
    buyer_apps ||--o{ buyer_app_keys : "authenticates with"
    event_schemas }o--o{ buyer_apps : "appears in schemas array"
    campaigns ||..o{ config_versions : "is versioned in"
    buyer_apps ||..o{ config_versions : "is versioned in"
    config_versions ||--|{ config_snapshots : "is published as"
    users ||--o{ users : "creates"
    users ||--o{ revokedtokens : "logs out"

    campaigns {
        uuid id PK "stored as _id"
        string code UK "fixed at creation"
        string name
        uuid categoryId FK "the promoted category"
        int internal_window_days
        long spend_paise
        string status "draft, live, paused, ended, archived"
        array buyer_apps "buyer_app_id, split_percent, landing_link"
        array affiliates "affiliate_id, commission_rate_percent, contract_window_days, status, channelIds"
        int current_version_no
    }
    buyer_apps {
        uuid id PK "stored as _id"
        string code UK
        string name
        string web_domain UK
        int data_tier "0, 1, 2"
        boolean mobile_app_ready
        object agreement "status, signed_on, tier2_addendum_ref"
        string lifecycle_status "onboarding, testing, live, suspended"
        date live_since
        object events_enabled
        array schemas "schema_version, status, migrate_by"
    }
    buyer_app_keys {
        string key_id PK "stored as _id"
        uuid buyer_app_id FK
        string key_hash "the key itself is never stored"
        string status "active, revoked"
    }
    affiliates {
        uuid id PK "stored as _id, generated by the server"
        string code UK "generated, never changes, e.g. ckB7XQ; used in tracking links"
        string name UK "unique ignoring letter case, 2 to 100 characters"
        string contactEmail "optional, lowercase"
        decimal defaultCommissionRatePercent "above 0, up to 100, 2 decimals; prefills campaigns"
        int defaultContractWindowDays "1 to 60, default 14; prefills campaigns"
        string status "active, paused; paused = not selectable for new campaigns"
        int currentVersionNo "ETag for safe concurrent edits"
        date createdAt
        date updatedAt
    }
    channels {
        uuid id PK "stored as _id, generated by the server"
        string name UK "unique ignoring letter case, 1 to 50 characters"
        int currentVersionNo "ETag for safe concurrent edits"
        date createdAt
        date updatedAt
    }
    categories {
        uuid id PK "stored as _id, generated by the server"
        string name UK "unique ignoring letter case"
        int defaultWindowDays "1 to 60, default 7"
        array aliases "names Buyer Apps send, lowercase, each in one category only"
        int currentVersionNo "ETag for safe concurrent edits"
        date createdAt
        date updatedAt
    }
    event_schemas {
        string schema_version PK "stored as _id"
        object definition "the seven events"
        string status "draft, current, deprecated, retired"
    }
    config_versions {
        uuid id PK "stored as _id"
        string item_type
        string item_id
        int version_no
        long publish_seq UK
        object content "the whole item"
        string reason
    }
    config_snapshots {
        long publish_seq PK
        string consumer PK "s2, s3, s4"
        object slice
        string checksum
    }
    users {
        uuid id PK "stored as _id; the token's sub"
        string email UK "stored lowercase"
        string name "2 to 100 characters; shown in history"
        string role "admin, user"
        string passwordHash "bcrypt; never returned by the API"
        string status "active, disabled"
        int failedAttempts "wrong passwords in a row; reset on success"
        date lockedUntil "now + 15 min on the 5th wrong try"
        uuid createdBy FK "the admin who created it; null for the first admin"
        date passwordChangedAt "tokens issued before it are refused"
        date lastLoginAt
        int currentVersionNo "ETag for safe concurrent edits"
        date createdAt
        date updatedAt
    }
    revokedtokens {
        uuid id PK "stored as _id; the logged-out token's jti"
        uuid userId FK "whose token it was"
        date expiresAt "the token's expiry; a TTL index deletes the record then"
        date createdAt "when the user logged out"
    }